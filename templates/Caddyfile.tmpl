{
    acme_dns cloudflare {env.CF_API_TOKEN}
}

liva.{{DOMAIN}} {
      root * /webpages/gift
      encode zstd gzip
      file_server

      @nocache path / *.html *.js *.css
      header @nocache Cache-Control "no-store"
      header /fonts/* Cache-Control "public, max-age=31536000, immutable"
      header /assets/* Cache-Control "public, max-age=604800"
}

schedule.{{DOMAIN}} {
    reverse_proxy schedule:8080
}

dav.{{DOMAIN}} {
    redir /.well-known/caldav / 301
    redir /.well-known/carddav / 301
    reverse_proxy radicale:5232
}

photos.{{DOMAIN}} {
  reverse_proxy immich_server:2283
}

pass.{{DOMAIN}} {
  reverse_proxy vaultwarden:80
}

status.{{DOMAIN}} {
  reverse_proxy uptime-kuma:3001
}

sync.{{DOMAIN}} {
  reverse_proxy host.docker.internal:8384
}

games.{{DOMAIN}} {
    reverse_proxy romm:8080
}

watch.{{DOMAIN}} {
  reverse_proxy jellyfin:8096
}

discover.{{DOMAIN}} {
