[Unit]
Description=Run docker update script on boot
After=docker.service network-online.target
Wants=network-online.target

# Must match DATA in config/site.env; run.sh rewrites it at install time.
# If the data disk never arrives, this unit does not run at all. Not on
# docker.service itself: a dead disk would then stop dockerd, and the LAN's
# DNS with it.
RequiresMountsFor=/srv/data

[Service]
Type=oneshot
# Path must match DOCKER_ROOT in config/site.env. systemd cannot expand a
# variable here, so run.sh rewrites it at install time.
ExecStart=/usr/bin/flock -w 3600 /run/bmo-backup.lock /srv/docker/scripts/update.sh

# Type=oneshot is subject to the start timeout, which defaults to 90s.
# update.sh rebuilds caddy from source (xcaddy, minutes) and pulls every
# image, so the default is far too short.
TimeoutStartSec=0
