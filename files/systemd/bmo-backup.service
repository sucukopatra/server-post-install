[Unit]
Description=restic backup of CONFIG and DATA to the NAS
Documentation=man:restic(1)

# The repository is reached over SSH, so this needs the network -- but not
# the NFS mount: nothing under $NAS is backed up.
Wants=network-online.target
After=network-online.target

# Ordering only: with docker down the files are still backed up and the
# missed dumps reported.
After=docker.service

# A catch-up run at boot lets the image pull finish first.
After=docker-update.service

# Must match DATA in config/site.env; run.sh rewrites it at install time.
# A catch-up run at boot then waits for the data disk instead of racing it.
RequiresMountsFor=/srv/data

# No ConditionPathExists=/etc/bmo-backup.env: a missing config should fail
# loudly, not show as a silently skipped unit.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/bmo-backup

# oneshot's default 90s start timeout would kill a real backup.
TimeoutStartSec=0

# best-effort/7 rather than idle, which can starve the job on a busy box.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Not sandboxed: it must read every $CONFIG, root's NAS key and the
# passphrase, and each Protect* setting would need an exception.

# restic's cache stays at /root/.cache/restic, shared with hand-runs.

# No [Install]: bmo-backup.timer drives it.
