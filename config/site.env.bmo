# bmo's host profile. run.sh seeds config/site.env from this file when it
# runs on a host named bmo and no site.env exists yet. Every setting is
# explained in site.env.example.

DOCKER_ROOT=/srv/docker
CONFIG=/srv/docker/config
DATA=/srv/data
DATA_IS_MOUNT=1

NAS=/srv/nas
NAS_HOST=192.168.1.11
NAS_EXPORT=/data

PUID=1000
PGID=1000
TZ=Europe/Istanbul
DOMAIN=domatesis.com
LAN_SUBNET=192.168.1.0/24

RESTIC_REPO=sftp:nas:/srv/mergerfs/pool/backups/bmo
NAS_SSH_USER=root
BACKUP_HOST=bmo
OFFSITE_REPO=s3:https://s3.eu-central-003.backblazeb2.com/bmo-restic-463fcf3d/bmo

HEALTHCHECK_URL=
