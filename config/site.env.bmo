# bmo's host profile. run.sh seeds config/site.env from this file when it
# runs on a host named bmo and no site.env exists yet -- which is how a
# reinstalled bmo gets its settings back. Not read on any other host.
#
# NOT encrypted, NOT secret -- paths and IDs only. Real credentials live
# in secrets/env.sops.

DOCKER_ROOT=/srv/docker
CONFIG=/srv/docker/config

# Local data disk (a separate ext4 volume on bmo)
DATA=/srv/data

# 1 = $DATA is a separate volume and must already be mounted before
# run.sh will create anything under it. Creating those directories on an
# unmounted $DATA writes them to the root disk, where the eventual mount
# hides them -- invisible, and quietly filling /.
# Set to 0 only if $DATA genuinely lives on the root filesystem.
DATA_IS_MOUNT=1

# NAS mount point and export. In --minimal, point NAS at a local
# directory and ignore NAS_HOST / NAS_EXPORT entirely.
NAS=/srv/nas
NAS_HOST=192.168.1.11
NAS_EXPORT=/data

# Ownership for created directories and for containers
PUID=1000
PGID=1000
TZ=Europe/Istanbul

# Your domain. Subdomains are derived from it in the Caddyfile template.
DOMAIN=domatesis.com

# LAN allowed through the firewall in full profile.
LAN_SUBNET=192.168.1.0/24

# restic repository. Required by --full. run.sh only ever *connects* to
# this -- it never runs `restic init`, which would orphan every snapshot.
RESTIC_REPO=sftp:nas:/srv/mergerfs/pool/backups/bmo
NAS_SSH_USER=root

# The name snapshots are recorded under, and what `restic forget` scopes
# retention to. Pinned rather than taken from the live hostname: if a
# reinstalled host comes up named anything else -- a typo at the
# installer prompt is enough -- new snapshots land under a new name and
# every existing snapshot silently stops being pruned, because retention
# only ever sees the new one. Leave empty to use this host's name as it
# is at provisioning time.
BACKUP_HOST=bmo

# sops version. Leave empty to install the latest release (default).
# Set to e.g. 3.13.3 only if you want to pin it.
SOPS_VERSION=

# Dead-man's switch for the backup. backup.sh pings this URL when a run
# starts, succeeds or fails; if the success ping does not arrive on
# schedule the far end alerts you. Empty disables it.
#
# This is the only thing that can tell you the backup stopped running --
# a host that is off, a timer that got disabled or a full disk all look
# like silence from here, and nothing running on bmo can report them.
#
# NORMALLY SET IN sops, NOT HERE. The ping URL is a capability: anyone
# holding it can send fake success pings and silence the alarm, so it
# does not belong in a committed file. run.sh reads it out of the
# decrypted .env, which means a rebuilt host recovers its monitoring from
# the same age key as everything else. To set it:
#
#   sops edit --input-type dotenv --output-type dotenv secrets/env.sops
#     then add: HEALTHCHECK_URL=https://hc-ping.com/<uuid>
#
# The two --*-type flags are required. sops infers format from the file
# extension and does not recognise .sops, so it falls back to binary and
# fails to parse the file at all.
#
# Setting it here overrides that, for a host that should point elsewhere.
# Create a check at https://healthchecks.io, or run your own Healthchecks
# instance -- anywhere but bmo.
HEALTHCHECK_URL=
